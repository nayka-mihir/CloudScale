# ==============================================================================
# CloudScale Backend Configuration
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# AWS Region & Resource Identifiers
AWS_REGION=ap-south-1
AWS_ASG_NAME=cloudscale-asg
AWS_TARGET_GROUP_ARN=

# Set to true to force simulation engine (great for local demo & offline dev)
# When deployed to EC2 with an IAM role, keep SIMULATE_AWS=false
SIMULATE_AWS=true

# ==============================================================================
# Admin Cockpit Authentication Credentials
# ==============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cloudscale2026
ADMIN_PIN=9988

